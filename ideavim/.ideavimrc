" IdeaVim config — NvChad style
" Command list: https://jb.gg/h38q75  |  Examples: https://jb.gg/share-ideavimrc

" ---- base ----
set clipboard+=unnamed
set clipboard+=ideaput
set scrolloff=5
set number
set relativenumber
set incsearch
set ignorecase
set smartcase
set hlsearch
set nowrap
set visualbell
set timeoutlen=100

" ---- leader / insert ----
let mapleader=" "
inoremap jk <Esc>

" ---- save / search ----
nnoremap <silent> <C-s> <Action>(SaveAll)
inoremap <C-s> <Esc><Action>(SaveAll)
nnoremap <silent> <Esc> :noh<CR>

" ---- files ----
nnoremap <leader>ff <Action>(GotoFile)
nnoremap <leader>fw <Action>(FindInPath)
nnoremap <leader>fs <Action>(FileStructurePopup)
nnoremap <leader>e  :NERDTreeToggle<CR>

" ---- tabs / buffers ----
nnoremap <Tab>     <C-^>
nnoremap <S-l>     <Action>(NextTab)
nnoremap <S-h>     <Action>(PreviousTab)
nnoremap <leader>x <Action>(CloseEditor)

" ---- windows ----
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l

" ---- LSP-like IDE actions ----
nnoremap <leader>gd <Action>(GotoDeclaration)
nnoremap <leader>gi <Action>(GotoImplementation)
nnoremap <leader>gt <Action>(GotoTypeDeclaration)
nnoremap <leader>gr <Action>(FindUsages)
nnoremap <leader>rn <Action>(RenameElement)
nnoremap <leader>ca <Action>(ShowIntentionActions)
nnoremap <leader>fm <Action>(ReformatCode)
nnoremap ]d         <Action>(GotoNextError)
nnoremap [d         <Action>(GotoPrevError)

" ---- plugins ----
set commentary
set sneak
set highlightedyank
set nerdtree
set surround

nmap <leader>/ <Plug>Commentary

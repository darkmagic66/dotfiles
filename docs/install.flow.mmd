%%{init: {'flowchart': {'curve': 'elk'}, 'theme': 'base'}}%%
flowchart TD
    Start([./bootstrap]) --> Dispatch{subcommand?}
    Dispatch -- packages --> SPkg["<b>setup_basic.sh</b><br/>manifest → adapter only"]
    Dispatch -- config --> SCfg["<b>config.sh</b> only<br/>(resolve_role + stow)"]
    Dispatch -- ai --> SAi["<b>setup_skills.sh</b> + <b>setup_rtk.sh</b><br/>(or ai list/update/status)"]
    SPkg --> SPkgDone([packages done])
    SCfg --> SCfgDone([config done])
    SAi --> SAiDone([skills done])
    Dispatch -- "none / --update" --> Full

    %% full flow — fidelity to bootstrap.d/lib/{full,config}.sh
    subgraph Full["full flow (no args / --update)"]
        UpdateFlag{--update flag?} -- yes --> UPDATE["UPDATE=true"]
        UpdateFlag -- no --> NOUPDATE["UPDATE=false"]
        UPDATE --> Net
        NOUPDATE --> Net
        Net[Check internet:<br/>curl github.com] --> NetOK{Reachable?}
        NetOK -- no --> Die1([exit 1])
        NetOK -- yes --> Detected["common.sh: OS/DISTRO detect<br/>export DOTFILES_DIR DISTRO OS_TYPE"]
        Detected --> Chmod[chmod +x script/*.sh]

        Chmod --> U1{UPDATE?}
        U1 -- yes --> U1Skip[skip packages + git identity]
        U1 -- no --> PkgStage["<b>setup_basic.sh</b><br/>packages/manifest.yaml → per-OS adapter"]
        PkgStage --> Match{DISTRO / ROLE?}
        Match -- "arch family" --> Arch["<b>adapters/pacman.sh</b><br/>pacman: common + linux<br/>paru bootstrap<br/>visual-studio-code-bin + python-xxh (AUR)<br/>services, cachyos-rate-mirrors"]
        Match -- mac --> Brew["<b>adapters/brew.sh</b><br/>brew bootstrap → shellenv eval<br/>brew update<br/>formulas: common + macos_extra minus curl<br/>casks: macos_casks + aldente if ROLE=personal"]
        Match -- debian --> Deb["<b>adapters/debian.sh</b><br/>fd symlink, zed installer,<br/>vscode MS apt repo"]
        Match -- fedora --> Fed["<b>adapters/fedora.sh</b><br/>zed installer,<br/>vscode MS dnf repo"]
        Arch --> GitID["<b>setup_git.sh</b><br/>interactive user.name/email<br/>(skipped in --update)"]
        Brew --> GitID
        Deb --> GitID
        Fed --> GitID
        U1Skip --> Cfg
        GitID --> Cfg["<b>config.sh</b><br/>resolve_role (hosts.sh)<br/>stow zsh tmux nvim kitty<br/>alacritty ideavim opencode xxh<br/>+ stow -d linux: hypr waybar gtk<br/>qt fontconfig (non-mac)<br/>+ roles/<role> when real content"]

        Cfg --> U2{"UPDATE and<br/>DISTRO==mac?"}
        U2 -- yes --> MacDefaults["<b>setup_mac.sh</b><br/>Finder/trackpad/keyboard defaults"] --> U3
        U2 -- no --> U3
        U3{UPDATE?} -- yes --> U3Skip[skip fonts]
        U3 -- no --> Fonts["<b>setup_fonts.sh</b><br/>symlink fonts/<br/>Linux→~/.local/share/fonts<br/>mac→~/Library/Fonts"]
        U3Skip --> Zsh
        Fonts --> Zsh["<b>setup_zsh.sh</b><br/>--update mode, or full + chsh<br/>clone p10k/autosuggestions/<br/>completions/syntax-hi/vi-mode + tpm"]
        Zsh --> Prog["<b>setup_programing.sh</b><br/>mise: go/java/node/rust from mise.toml<br/>GitNexus (npm -g)<br/>rtk (paru/yay/brew/curl) — installed FIRST,<br/>rtk plugin runs LAST"]
        Prog --> Ai
    end

    Ai["<b>setup_skills.sh</b><br/>submodules + symlinks into<br/>opencode/claude/codex/.agents<br/>(--update in full --update)<br/><b>setup_rtk.sh</b><br/>rtk init -g --opencode"] --> Done([Installation Complete!])

    class U1Skip,U3Skip skipNode
    class Die1 dieNode
    class PkgStage pkgNode
    class Arch,Brew,Deb,Fed,MacDefaults osNode
    class Fonts,Zsh,Ai postNode
    class Cfg cfgNode
